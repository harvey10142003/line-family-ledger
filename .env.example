# ============== Database ==============
DATABASE_URL="postgresql://user:password@host:5432/family_ledger"

# ============== Server ==============
PORT=3000
NODE_ENV=development
PUBLIC_URL=https://your-domain.zeabur.app

# ============== LINE ==============
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_LIFF_ID=1234567890-AbCdEfGh
# LIFF 所屬 LINE Login channel id（/api/liff/* 驗 ID token 的 aud）。未設時取 LINE_LIFF_ID 的前綴
LINE_LOGIN_CHANNEL_ID=1234567890

# ============== AI ==============
# Google Gemini 2.5 Flash — 同時負責文字記帳 parse + 收據圖片 OCR
GEMINI_API_KEY=AIzaSyXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash
# 送 Gemini 的文字一律先遮罩（卡號／帳號／身分證／手機／Email／地址），不用另外設定

# ============== 敏感欄位加密（財務中樞 P0-3）==============
# AES-256-GCM 主金鑰，32 bytes（openssl rand -hex 32）。只放部署平台秘密管理，另外離線備份；搬主機要帶同一把。
# 不設：記帳照常，只有登記帳單戶名等敏感欄位回 503（不會改存明文）。輪替方式見 docs/deploy/finance-hub-p0-security.md
LEDGER_FIELD_KEY=
LEDGER_FIELD_KEY_VERSION=1
# 只在輪替期間設：舊版本:舊金鑰（多把用逗號）
LEDGER_FIELD_KEYS_OLD=

# ============== 定期提醒（階段 3b）==============
# in-process node-cron 預設開啟：每月 1 號 09:00 推月結、每週一 09:00 推預算週報（台北時區）
# 若改用外部排程器（Zeabur cron job 打 /jobs/*），設成 true 關閉內建 cron 避免重複推播
DISABLE_INPROCESS_CRON=false
# 設了才會啟用 POST /jobs/:task 手動/外部觸發端點，並用 x-cron-secret header 驗證
CRON_SECRET=

# ============== Web (Next.js) ==============
NEXT_PUBLIC_LIFF_ID=1234567890-AbCdEfGh
NEXT_PUBLIC_API_BASE=https://your-domain.zeabur.app

# 外幣參考匯率：正式來源是臺灣銀行牌告（平日 16:30 自動抓，存 FxRateDaily；需能連 https://rate.bot.com.tw）。
# 臺銀查不到時才用這裡（1 單位外幣＝多少台幣，JSON），再沒有就用程式固定值。可不設。
FX_REFERENCE_RATES=
