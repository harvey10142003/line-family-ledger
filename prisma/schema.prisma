// LINE 家庭共同記帳 — Prisma schema
// 一對多架構：一個 LINE@ 服務多個家庭，使用 6 碼家庭碼識別

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== 家庭 =====
model Family {
  id          String   @id @default(cuid())
  name        String
  familyCode  String   @unique // 6 碼大寫英數，如 "AB12CD"
  ownerLineId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           FamilyMember[]
  categories        Category[]
  transactions      Transaction[]
  invites           InviteLink[]
  budgets           Budget[]
  accounts          Account[]
  transfers         Transfer[]
  creditCards       CreditCard[]
  recurringRules    RecurringRule[]
  savingsGoals      SavingsGoal[]
  liabilities       Liability[]
  cardStatements    CardStatement[]
  netWorthSnapshots NetWorthSnapshot[]

  @@index([ownerLineId])
}

// ===== 家庭成員（綁定 LINE userId）=====
model FamilyMember {
  id           String   @id @default(cuid())
  familyId     String
  lineUserId   String
  displayName  String
  avatarUrl    String?
  role         Role     @default(MEMBER)
  joinedAt     DateTime @default(now())
  // 帳單上的戶名（例如「施允瀚」），歸屬比對用。只存應用層加密後的密文（P0-3 加密工具），不存明文；null＝未登記
  legalNameEnc String?

  family           Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  transfers        Transfer[]
  // 財務中樞：這位成員「個人」的帳戶／卡／負債（ownerMemberId 指向他）
  ownedAccounts    Account[]     @relation("AccountOwner")
  ownedCreditCards CreditCard[]  @relation("CreditCardOwner")
  ownedLiabilities Liability[]   @relation("LiabilityOwner")

  @@unique([familyId, lineUserId])
  @@index([lineUserId])
}

enum Role {
  OWNER
  MEMBER
}

// ===== 分類 =====
model Category {
  id        String       @id @default(cuid())
  familyId  String
  name      String
  icon      String?
  type      CategoryType
  isDefault Boolean      @default(false)
  sortOrder Int          @default(0)

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([familyId, name])
}

enum CategoryType {
  EXPENSE
  INCOME
}

// ===== 交易 =====
model Transaction {
  id                 String            @id @default(cuid())
  familyId           String
  memberId           String
  categoryId         String
  accountId          String? // 付款帳戶（現金/銀行/電子支付）；null = 未指定（含舊資料）
  creditCardId       String? // 用信用卡付款時填此；與 accountId 二擇一
  amount             Decimal           @db.Decimal(12, 2)
  note               String?
  paidAt             DateTime
  isShared           Boolean           @default(true) // true=家庭共同(納入分帳)；false=個人支出(不分帳)
  source             TransactionSource @default(TEXT)
  createdAt          DateTime          @default(now())
  // ---- 財務中樞 P1-1（只加不改；舊資料＝家庭、無報帳、無原幣）----
  bookTo             BookTo            @default(FAMILY) // FAMILY＝家庭的錢；BUSINESS＝代墊公司費用（家庭支出不算）
  reimburseStatus    ReimburseStatus   @default(NONE) // 代墊公司費用的報帳進度
  postedAt           DateTime? // 入帳日（帳單上的入帳日，跟消費日 paidAt 分開）；null＝未知
  originalCurrency   String? // 外幣交易的原幣別（ISO 4217，例如 USD）；null＝台幣
  originalAmount     Decimal?          @db.Decimal(14, 2) // 原幣金額
  amountEstimated    Boolean           @default(false) // true＝amount 是用參考匯率估的台幣，卡帳單進來後改實際值
  // ---- 財務中樞 P1-6（只加不改）：「幫 Apple 記」時 memberId＝歸屬人（Apple），這裡記實際打字的人；null＝本人記的（含舊資料）
  recordedByMemberId String?
  // ---- 外幣參考匯率（11-05，只加不改）：amountEstimated 時用的是哪個匯率；null＝台幣或舊資料
  fxRate             Decimal?          @db.Decimal(14, 6) // 1 單位外幣＝多少台幣
  fxRateDate         DateTime?         @db.Date // 牌告日期（消費日當天或之前最近一個營業日）；env／固定值時為 null
  fxRateSource       String? // BOT_SPOT_SELL／BOT_CASH_SELL（臺銀牌告）、ENV（FX_REFERENCE_RATES）、DEFAULT（程式固定值）

  family     Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member     FamilyMember @relation(fields: [memberId], references: [id])
  category   Category     @relation(fields: [categoryId], references: [id])
  account    Account?     @relation(fields: [accountId], references: [id])
  creditCard CreditCard?  @relation(fields: [creditCardId], references: [id])
  receipt    Receipt?

  @@index([familyId, paidAt])
  @@index([familyId, categoryId])
  @@index([memberId])
  @@index([accountId])
  @@index([creditCardId])
}

enum BookTo {
  FAMILY
  BUSINESS
}

enum ReimburseStatus {
  NONE
  PENDING
  CLAIMED
  REIMBURSED
}

enum TransactionSource {
  TEXT // LINE 文字訊息輸入
  PHOTO // 收據拍照辨識
  MANUAL // LIFF 表單手動輸入
  RECURRING // 固定收支自動產生
}

// ===== 預算（每月循環）=====
model Budget {
  id         String   @id @default(cuid())
  familyId   String
  categoryId String? // null = 整體月預算；有值 = 該分類月預算
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

// ===== 帳戶（= 付款方式：現金/銀行/信用卡/電子支付）=====
model Account {
  id             String         @id @default(cuid())
  familyId       String
  name           String
  type           AccountType    @default(CASH)
  icon           String?
  openingBalance Decimal        @default(0) @db.Decimal(12, 2) // 期初餘額
  isDefault      Boolean        @default(false) // 記帳未指定時的預設帳戶
  isArchived     Boolean        @default(false)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  // ---- 財務中樞 P1-1（只加不改；舊資料＝共同、家庭、全家看得到明細）----
  ownerMemberId  String? // null＝共同帳戶；有值＝該成員個人的
  visibility     Visibility     @default(FAMILY_FULL) // 對其他家庭成員的可見程度（共同帳戶一律視為全家可見）
  purpose        AccountPurpose @default(FAMILY) // BUSINESS＝公司帳戶，不算家庭淨資產與收支
  institution    String? // 銀行代碼／名稱，例如「808 玉山」
  accountLast4   String? // 帳號末四碼（絕不存全碼）
  currency       String         @default("TWD")
  aliases        String[]       @default([]) // 使用者用過的叫法（文字記帳模糊比對、自動學）

  family            Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner             FamilyMember? @relation("AccountOwner", fields: [ownerMemberId], references: [id], onDelete: Restrict)
  transactions      Transaction[]
  transfersOut      Transfer[]    @relation("TransferFrom")
  transfersIn       Transfer[]    @relation("TransferTo")
  liabilityAutopays Liability[]   @relation("LiabilityPayFrom")

  @@unique([familyId, name])
  @@index([familyId])
  @@index([ownerMemberId])
}

enum AccountType {
  CASH // 現金
  BANK // 銀行（含純網銀，以 institution 區分）
  CREDIT_CARD // 信用卡
  EPAYMENT // 電子支付（LINE Pay / 街口…）
  OTHER
  TIME_DEPOSIT // 定存
  SECURITIES // 證券（估值，非加減算）
  INVESTMENT // 基金／保單價值等（估值）
  CRYPTO // 虛擬資產（估值）
}

// 帳戶／卡／負債對「其他家庭成員」的可見程度（本人永遠看得到全部）
enum Visibility {
  FAMILY_FULL // 全家看得到明細
  FAMILY_TOTAL_ONLY // 其他成員只看得到總額（餘額／欠款），看不到每一筆
  OWNER_ONLY // 其他成員完全看不到，也不算進他們看到的家庭數字
}

enum AccountPurpose {
  FAMILY
  BUSINESS
}

// ===== 儲蓄目標 =====
model SavingsGoal {
  id           String    @id @default(cuid())
  familyId     String
  name         String
  icon         String?
  targetAmount Decimal   @db.Decimal(12, 2)
  savedAmount  Decimal   @default(0) @db.Decimal(12, 2)
  targetDate   DateTime?
  isArchived   Boolean   @default(false)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

// ===== 固定收支 / 週期記帳（每月或每週自動產生交易）=====
model RecurringRule {
  id           String        @id @default(cuid())
  familyId     String
  memberId     String // 建立者（產生的交易記在他名下）
  categoryId   String
  accountId    String?
  creditCardId String?
  amount       Decimal       @db.Decimal(12, 2)
  note         String?
  isShared     Boolean       @default(true)
  frequency    RecurringFreq @default(MONTHLY)
  dayOfMonth   Int           @default(1) // MONTHLY 用（1-31，超過月底自動clamp）
  dayOfWeek    Int           @default(1) // WEEKLY 用（0=日 .. 6=六）
  isActive     Boolean       @default(true)
  lastPostedAt DateTime? // 防同日重複產生
  createdAt    DateTime      @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

enum RecurringFreq {
  MONTHLY
  WEEKLY
}

// ===== 信用卡（與帳戶分開：有額度/結算日/繳費日）=====
model CreditCard {
  id              String     @id @default(cuid())
  familyId        String
  name            String
  creditLimit     Decimal    @default(0) @db.Decimal(12, 2) // 額度
  statementDay    Int        @default(1) // 結算日（每月幾號）
  dueDay          Int        @default(15) // 繳費日（每月幾號）
  icon            String?
  isArchived      Boolean    @default(false)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  // ---- 財務中樞 P1-1（只加不改；舊資料＝共同、全家看得到明細）----
  ownerMemberId   String? // null＝共同；有值＝該成員的卡（附卡算正卡人）
  visibility      Visibility @default(FAMILY_FULL)
  issuer          String? // 發卡行
  cardLast4       String? // 卡號末四碼（絕不存全碼）
  isSupplementary Boolean    @default(false) // 附卡
  aliases         String[]   @default([])

  family       Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner        FamilyMember?   @relation("CreditCardOwner", fields: [ownerMemberId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  statements   CardStatement[]
  payments     Transfer[]      @relation("TransferToCard")

  @@unique([familyId, name])
  @@index([familyId])
  @@index([ownerMemberId])
}

// ===== 信用卡帳單（每一期一列；同一期只會有一列＝冪等基礎）=====
model CardStatement {
  id            String              @id @default(cuid())
  familyId      String
  cardId        String
  periodStart   DateTime?
  periodEnd     DateTime?
  statementDate DateTime // 結帳日
  dueDate       DateTime // 繳款截止日
  newBalance    Decimal             @db.Decimal(14, 2) // 本期應繳
  minimumDue    Decimal?            @db.Decimal(14, 2) // 最低應繳
  paidAmount    Decimal             @default(0) @db.Decimal(14, 2) // 已繳（繳卡費轉帳沖這裡）
  status        CardStatementStatus @default(OPEN)
  documentId    String? // 來源文件（P2 Document 表上線後才加 FK）
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  card     CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  payments Transfer[] @relation("TransferCardStatement")

  @@unique([cardId, statementDate])
  @@index([familyId])
}

enum CardStatementStatus {
  OPEN
  PAID
  PARTIAL
  OVERDUE
}

// ===== 負債／借出（BORROWED＝我們欠別人；LENT＝別人欠我們，算資產）=====
model Liability {
  id                String             @id @default(cuid())
  familyId          String
  ownerMemberId     String? // null＝共同
  visibility        Visibility         @default(FAMILY_FULL)
  direction         LiabilityDirection @default(BORROWED)
  kind              LiabilityKind      @default(OTHER)
  name              String // 顯示名稱，例如「房貸」「借小明」
  lender            String? // 貸款銀行／債權人（借出時＝借款人）
  principal         Decimal            @db.Decimal(14, 2) // 原始本金
  annualRate        Decimal?           @db.Decimal(7, 4) // 年利率（%）；親友借款可為 null
  termMonths        Int?
  startDate         DateTime? // 首次還款日
  paymentDay        Int? // 每月還款日
  method            RepaymentMethod    @default(FREE)
  gracePeriodMonths Int                @default(0)
  payFromAccountId  String?
  currentPrincipal  Decimal            @db.Decimal(14, 2) // 剩餘本金（以最近一次對帳值為準）
  currency          String             @default("TWD")
  aliases           String[]           @default([])
  note              String?
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  family        Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner         FamilyMember?         @relation("LiabilityOwner", fields: [ownerMemberId], references: [id], onDelete: Restrict)
  payFrom       Account?              @relation("LiabilityPayFrom", fields: [payFromAccountId], references: [id], onDelete: SetNull)
  rateChanges   LiabilityRateChange[]
  payments      LiabilityPayment[]
  transfersFrom Transfer[]            @relation("TransferFromLiability")
  transfersTo   Transfer[]            @relation("TransferToLiability")

  @@index([familyId])
  @@index([ownerMemberId])
}

enum LiabilityDirection {
  BORROWED
  LENT
}

enum LiabilityKind {
  MORTGAGE // 房貸
  CAR // 車貸
  PERSONAL // 信貸
  FAMILY // 親友借款
  OTHER
}

enum RepaymentMethod {
  EQUAL_PAYMENT // 本息平均
  EQUAL_PRINCIPAL // 本金平均
  INTEREST_ONLY // 寬限期只繳息
  FREE // 無固定（親友）
}

model LiabilityRateChange {
  id            String   @id @default(cuid())
  liabilityId   String
  effectiveDate DateTime
  annualRate    Decimal  @db.Decimal(7, 4)
  createdAt     DateTime @default(now())

  liability Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)

  @@index([liabilityId, effectiveDate])
}

model LiabilityPayment {
  id            String    @id @default(cuid())
  liabilityId   String
  paidAt        DateTime
  total         Decimal   @db.Decimal(14, 2)
  principalPart Decimal   @default(0) @db.Decimal(14, 2) // 本金（不是支出）
  interestPart  Decimal   @default(0) @db.Decimal(14, 2) // 利息（支出）
  feePart       Decimal   @default(0) @db.Decimal(14, 2) // 帳管費／違約金（支出）
  transactionId String? // 利息／手續費那筆支出
  transferId    String? // 本金那筆轉帳
  undoneAt      DateTime? // P1-4：對應的轉帳被撤銷時一起標記（不刪資料）
  createdAt     DateTime  @default(now())

  liability Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)

  @@index([liabilityId, paidAt])
}

// ===== 帳戶間轉帳（不計入收支，只移動餘額）=====
model Transfer {
  id                   String                @id @default(cuid())
  familyId             String
  memberId             String
  // P1-4 起放寬成可為 null（DROP NOT NULL，不刪資料）：繳卡費的目的是卡、還貸款的目的是負債、
  // 借入／收回的來源是負債。舊資料兩端都有值，行為不變。來源、目的各填一個，組合由 lib/transfer-rules.ts 檢查。
  fromAccountId        String?
  toAccountId          String?
  amount               Decimal               @db.Decimal(12, 2)
  note                 String?
  transferredAt        DateTime
  createdAt            DateTime              @default(now())
  // ---- 財務中樞 P1-1（只加不改；舊資料＝一般帳戶轉帳、手動、未對帳、未撤銷）----
  kind                 TransferKind          @default(ACCOUNT)
  fromLiabilityId      String?
  toCreditCardId       String?
  toLiabilityId        String?
  cardStatementId      String? // CARD_PAYMENT 沖哪一期帳單
  fee                  Decimal?              @db.Decimal(14, 2) // 手續費（另記一筆支出，見 linkedTransactionIds）
  interest             Decimal?              @db.Decimal(14, 2) // P1-4：連帶利息（還貸款＝支出；收回借款、定存解約＝收入；另記一筆交易）
  source               TransferSource        @default(MANUAL)
  reconcileStatus      ReconcileStatus       @default(UNRECONCILED)
  linkedTransactionIds String[]              @default([]) // 這次轉帳順帶產生的支出（利息、手續費）
  undoneAt             DateTime? // 撤銷時間（撤銷不刪資料）
  undoneByMemberId     String?
  // ---- 財務中樞 P1-5（只加不改；舊資料＝已生效）D18：文字轉帳動到「對方個人帳戶」→ 先待對方確認 ----
  confirmStatus        TransferConfirmStatus @default(CONFIRMED)
  counterpartMemberId  String? // 要按確認的人（被動到個人帳戶的那位）
  counterpartSide      TransferSide? // 對方的是來源還是目的那一端
  confirmDeadline      DateTime? // 建立後 24 小時；過了沒確認 → ONE_SIDED
  confirmedAt          DateTime?
  rejectedAt           DateTime?

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member        FamilyMember   @relation(fields: [memberId], references: [id])
  // 改成可選後明寫 onDelete: Restrict，維持原本必填關聯的外鍵行為（Prisma 可選關聯預設是 SetNull，會重建外鍵）
  fromAccount   Account?       @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toAccount     Account?       @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fromLiability Liability?     @relation("TransferFromLiability", fields: [fromLiabilityId], references: [id], onDelete: Restrict)
  toCreditCard  CreditCard?    @relation("TransferToCard", fields: [toCreditCardId], references: [id], onDelete: Restrict)
  toLiability   Liability?     @relation("TransferToLiability", fields: [toLiabilityId], references: [id], onDelete: Restrict)
  cardStatement CardStatement? @relation("TransferCardStatement", fields: [cardStatementId], references: [id], onDelete: SetNull)

  @@index([familyId, transferredAt])
  @@index([confirmStatus, confirmDeadline])
}

// D18：轉帳生效狀態。只有 CONFIRMED 會動餘額、帳單、負債、連帶收支；
// ONE_SIDED＝對方 24 小時沒回，只算建立者自己那一端的帳戶（標「待確認」），對方之後仍可確認或拒絕。
enum TransferConfirmStatus {
  CONFIRMED
  PENDING
  ONE_SIDED
  REJECTED
}

enum TransferSide {
  FROM
  TO
}

enum TransferKind {
  ACCOUNT // 一般轉帳
  CARD_PAYMENT // 繳信用卡
  CASH_WITHDRAW // 提領現金
  CASH_DEPOSIT // 存入現金
  TIME_DEPOSIT // 轉定存／定存解約
  LOAN_REPAY // 還貸款（只放本金）
  LEND // 借出
  BORROW // 借入
  COLLECT // 收回借款
  SPOUSE // 夫妻之間
}

enum TransferSource {
  TEXT
  MANUAL
  STATEMENT
  PASSBOOK
  EMAIL
}

enum ReconcileStatus {
  UNRECONCILED
  RECONCILED
}

// ===== 每月淨資產快照（財務中樞 P1-7，規格 2.7）=====
// 每月 1 號 08:30（台北）依「上個月最後一天」算一次存下來，之後改舊資料歷史點也不跳（要重算手動按）。
// 規格 2.7 原寫 scope＝FAMILY｜MEMBER；但「家庭淨資產」依看的人可見範圍不同（D2：對方 OWNER_ONLY 不算），
// 所以改成每位成員各存一份「他看得到的家庭數字」，每人各自的那條線放在 breakdown.byOwner。
model NetWorthSnapshot {
  id             String   @id @default(cuid())
  familyId       String
  month          String // "YYYY-MM"：這個月最後一天的狀態
  viewerMemberId String // 以哪位成員的可見範圍算
  assets         Decimal  @db.Decimal(14, 2)
  liabilities    Decimal  @db.Decimal(14, 2)
  netWorth       Decimal  @db.Decimal(14, 2)
  breakdown      Json // 組成（依類型）、每人各自（byOwner）、明細列（看得到明細的才有名稱）
  asOf           DateTime // 計算基準時間點（該月最後一天台北 23:59:59.999）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, month, viewerMemberId])
  @@index([familyId, viewerMemberId])
}

// ===== 收據圖片 =====
model Receipt {
  id            String   @id @default(cuid())
  transactionId String   @unique
  imageUrl      String
  aiParsedJson  Json?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

// ===== 邀請連結 =====
model InviteLink {
  id        String    @id @default(cuid())
  familyId  String
  code      String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  usedCount Int       @default(0)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// 外幣參考匯率。11-07 起來源＝財政部關務署每旬報關匯率（一旬一份，rateDate＝旬首，見 server/src/lib/fx-rates.ts）；
// 之前是臺灣銀行牌告（每營業日一份收盤價，source=BOT，舊資料保留）。
// 數字是「1 單位外幣＝多少台幣」；沒有報價（例如 ZAR 沒有現金、IDR 沒有即期）存 null。
// 記帳時用「消費日當天或之前最近一筆」（關務署那筆＝消費日所在的旬）。
model FxRateDaily {
  id        String   @id @default(cuid())
  rateDate  DateTime @db.Date
  currency  String // ISO 4217
  spotBuy   Decimal? @db.Decimal(14, 6) // 即期買入
  spotSell  Decimal? @db.Decimal(14, 6) // 即期賣出（信用卡外幣消費估算用這個）
  cashBuy   Decimal? @db.Decimal(14, 6) // 現金買入
  cashSell  Decimal? @db.Decimal(14, 6) // 現金賣出（沒有即期時才用）
  source    String   @default("BOT") // CUSTOMS＝關務署每旬報關匯率（11-07 起；rateDate＝旬首，買→spotBuy、賣→spotSell）｜BOT＝臺銀牌告（舊資料）
  fetchedAt DateTime @default(now())

  @@unique([currency, rateDate])
}

// ===== 稽核紀錄（財務中樞 P0-4，規格 6.8）=====
// 只加不改：程式只會 create（棘輪 audit-append-only.test.ts 守門），資料庫另有 trigger 擋 UPDATE／DELETE／TRUNCATE
// （開機時 ensureAuditAppendOnly() 建立）。不掛外鍵：成員、帳戶刪掉後紀錄仍要留著。
// detail 只放 id、欄位名稱、列舉值、筆數，不放備註、姓名、金額以外的原文（services/audit.ts 會擋）。
model AuditLog {
  id              String   @id @default(cuid())
  familyId        String
  actorMemberId   String? // 誰做的；null＝系統（排程、金鑰輪替）
  channel         String // LIFF | LINE | SYSTEM
  action          String // VIEW_PERSONAL | EDIT | DELETE | EXPORT_CSV | PERMISSION_CHANGE | ...（services/audit.ts）
  targetType      String // TRANSACTION | ACCOUNT | CREDIT_CARD | LIABILITY | TRANSFER | MEMBER | ...
  targetId        String?
  subjectMemberId String? // 被存取的是誰的東西（個人帳戶的主人）；共同的＝null
  detail          Json?
  createdAt       DateTime @default(now())

  @@index([familyId, createdAt])
  @@index([subjectMemberId, createdAt])
  @@index([actorMemberId, createdAt])
}
